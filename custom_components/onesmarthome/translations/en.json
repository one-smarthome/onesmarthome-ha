{
  "title": "One SmartHome",

  "config": {
    "step": {
      "user": {
        "title": "Connect One SmartHome to Grenton",
        "description": "Enter the controller address and access token. One SmartHome will load the interface configuration locally, create supported entities, and keep their state synchronized without using the cloud.",
        "data": {
          "ip_address": "Controller IP address",
          "token": "Token"
        },
        "data_description": {
          "ip_address": "Local controller IP address on the Home Assistant network, for example 192.168.100.15.",
          "token": "Token used to authorize loading the interface configuration. It stays stored locally in Home Assistant."
        }
      },
      "reconfigure": {
        "title": "Reload the Grenton interface",
        "description": "One SmartHome will download the interface configuration again and refresh the stored copy. Entities that no longer exist in the interface will be removed; new ones will be added.",
        "data": {
          "ip_address": "Controller IP address",
          "token": "Token"
        },
        "data_description": {
          "ip_address": "Local controller IP address on the Home Assistant network, for example 192.168.100.15.",
          "token": "Token used to authorize loading the interface configuration. It stays stored locally in Home Assistant."
        }
      }
    },
    "error": {
      "invalid_auth": "The token was rejected. Check its value and try again.",
      "invalid_data": "The downloaded interface data is incomplete or uses an unsupported format.",
      "cannot_connect": "Could not connect to the given controller IP address on the local network.",
      "unknown": "An unexpected error occurred while preparing the integration."
    },
    "abort": {
      "already_configured": "This Grenton installation is already set up in Home Assistant.",
      "interface_mismatch": "The downloaded interface belongs to a different Grenton installation than this entry.",
      "reconfigure_successful": "The interface configuration has been refreshed."
    }
